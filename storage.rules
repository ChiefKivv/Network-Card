rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null &&
             request.auth.token.email == "doublecupbookings@gmail.com";
    }

    match /mixes/{fileName} {
      allow read: if true;
      allow create, update: if isAdmin()
                            && request.resource != null
                            && (request.resource.contentType == "audio/mpeg" ||
                             request.resource.contentType == "audio/aiff" ||
                             request.resource.contentType == "audio/x-aiff")
                            && request.resource.size > 0
                            && request.resource.size <= 2 * 1024 * 1024 * 1024;
      allow delete: if isAdmin();
    }

    // Everything outside /mixes is denied by default.
  }
}
